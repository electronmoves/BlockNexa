# BlockNexa Environment Configuration (Placeholder Values Only — NEVER commit real secrets)

PORT=3000
NODE_ENV=production
TRUST_PROXY=1
DATA_DIR=./data

# Core Security Secrets (generate strong 32+ char random strings)
ADMIN_KEY=replace-with-strong-random-admin-key
APP_SECRET=replace-with-64-char-random-hex-secret
# 10-Key Internal Seal Signature Ring (comma-separated 10 secret strings; used randomly with APP_SECRET to seal Buy, Sell, Withdraw & Ledger)
# Generate your own 10 private keys locally with: node -e "console.log('SEAL_SIGNATURES='+Array.from({length:10},()=>require('crypto').randomBytes(24).toString('hex')).join(','))"
SEAL_SIGNATURES=replace_sig_1,replace_sig_2,replace_sig_3,replace_sig_4,replace_sig_5,replace_sig_6,replace_sig_7,replace_sig_8,replace_sig_9,replace_sig_10
ADMIN_PATH=replace-with-long-random-secret-admin-path
ADMIN_GATE_KEY=
ADMIN_IPS=

# Trading Rates & Limits
BUY_RATE=102.5
SELL_RATE=100
MIN_BUY_USDT=5
MAX_BUY_INR=5000
MIN_CASHQR_INR=2000
MAX_CASHQR_INR=10000
CASHQR_STEP=500
MIN_SELL_USDT=5
MIN_WITHDRAW=5

# Payment Destinations
UPI_NAME=BlockNexa
UPI_IDS=merchant1@upi,merchant2@upi
DEPOSIT_ADDRESS=0x0000000000000000000000000000000000000000

# BSC Hot Wallet (Option 1: 1-Click Admin Auto-Payout on BEP20 — use a dedicated payout wallet only!)
HOT_WALLET_PRIVATE_KEY=
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Telegram OTP & Admin Alerts
OTP_TRANSPORT=telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
ADMIN_TELEGRAM=

# Optional Google Sign-In (Public OAuth Client ID)
GOOGLE_CLIENT_ID=
